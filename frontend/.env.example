# Copy to .env and fill in your own keys. .env is git-ignored.
# Note: every VITE_* value is bundled into the browser JS, so treat these as public client keys.

# 공공데이터포털 (data.go.kr) service keys
VITE_OPEN_API_SERVICE_KEY=
VITE_DISABLED_FACILITIES_SERVICE_KEY=

# Kakao (developers.kakao.com)
VITE_KAKAO_MAP_SERVICE_KEY=
VITE_KAKAO_REST_SERVICE_KEY=

# API URL settings for PJT
VITE_VUE_API_URL=http://localhost:80

# count per page
VITE_ARTICLE_LIST_SIZE=20
VITE_ARTICLE_NAVIGATION_SIZE=5
